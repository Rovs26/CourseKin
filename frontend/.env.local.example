# ── API ───────────────────────────────────────────────────────────────────────
# Browser requests use the same-origin Next.js proxy; the upstream URL is server-side only.
NEXT_PUBLIC_API_BASE_URL=/api
COURSEKIN_API_UPSTREAM_URL=http://localhost:8000
# Legacy deployments may continue to provide NEXT_PUBLIC_REVIEWFLOW_API_URL during migration.
NEXT_PUBLIC_BILLING_ENABLED=false

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Get from Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk mounted routes and fallback redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Observability ─────────────────────────────────────────────────────────────
# Get from Sentry dashboard → Settings → Projects → <project> → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
# Server-side only — for Sentry source map uploads during CI/CD builds
SENTRY_AUTH_TOKEN=

# ── Abuse prevention ─────────────────────────────────────────────────────────
# Get from Cloudflare dashboard → Turnstile → Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
