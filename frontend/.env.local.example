# ── API ───────────────────────────────────────────────────────────────────────
# URL of the ReviewFlow API; change to https://api.reviewflow.app in production
NEXT_PUBLIC_REVIEWFLOW_API_URL=http://localhost:8000
NEXT_PUBLIC_BILLING_ENABLED=false

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Get from Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Observability ─────────────────────────────────────────────────────────────
# Get from Sentry dashboard → Settings → Projects → <project> → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
# Server-side only — for Sentry source map uploads during CI/CD builds
SENTRY_AUTH_TOKEN=

# ── Abuse prevention ─────────────────────────────────────────────────────────
# Get from Cloudflare dashboard → Turnstile → Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
