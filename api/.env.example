# Core
APP_NAME=CourseKin API
# Use staging or production only with Postgres, auth, R2, Turnstile, and Redis configured.
APP_ENV=development
DATABASE_URL=sqlite:///./data/reviewflow.db
FRONTEND_URL=http://localhost:3000

# OpenAI generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_TIMEOUT_SECONDS=60

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# Quotas and input bounds
FREE_TIER_MONTHLY_USD=0.25
PAID_TIER_MONTHLY_USD=3.00
MAX_EXTRACTED_CHARS=50000

# Durable jobs and shared rate limits
# Use redis://<host>:6379/0 in production; empty is acceptable only for local single-process use.
RATE_LIMIT_STORAGE_URI=
JOB_POLL_SECONDS=1
JOB_STALE_SECONDS=300
JOB_MAX_ATTEMPTS=3

# Local development upload fallback
UPLOAD_DIR=./uploads

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Admin and observability
ADMIN_EMAILS=
SENTRY_DSN_API=
AXIOM_TOKEN=
AXIOM_DATASET=coursekin-prod
RESEND_API_KEY=

# Polar billing. Keep disabled until live checkout, webhook, and deletion tests pass.
BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# These are Polar product IDs, not legacy price IDs.
POLAR_PLUS_MONTHLY_PRODUCT_ID=
POLAR_PLUS_YEARLY_PRODUCT_ID=

# Cloudflare R2 uploads
# Rotation procedure (J1):
#   1. Create a new R2 API token alongside the current one.
#   2. Deploy with NEW values in R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY.
#   3. After 24h (long enough for any outstanding presigned URLs to expire —
#      see R2_PRESIGN_EXPIRY_SECONDS), revoke the previous token in R2.
#   4. Audio uploads use a separate prefix `audio-temp/{user_id}/...` and are
#      deleted by the background worker, so rotation does not require any
#      data migration. Long-lived source uploads live under `uploads/`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=coursekin-uploads
R2_ENDPOINT_URL=
R2_PRESIGN_EXPIRY_SECONDS=300

# Audio E1 (lecture transcription via OpenAI Whisper). Off by default; flip to
# true only once R2, OpenAI billing, and the per-user monthly cap are sized
# for whisper-1 at $0.006/min. The consent version must change whenever the
# disclosure copy in the UI changes — every user re-accepts on next upload.
AUDIO_E1_ENABLED=false
AUDIO_WHISPER_MODEL=whisper-1
AUDIO_SUMMARY_MODEL=gpt-4o-mini
AUDIO_MAX_FILE_BYTES=104857600
AUDIO_MAX_DURATION_SECONDS=3600
AUDIO_CONSENT_VERSION=2026-05-v1
