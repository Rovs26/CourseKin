# Core
APP_NAME=ReviewFlow API
APP_ENV=development
DATABASE_URL=sqlite:///./data/reviewflow.db
FRONTEND_URL=http://localhost:3000

# OpenAI generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_TIMEOUT_SECONDS=60

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# Quotas and input bounds
FREE_TIER_MONTHLY_USD=0.25
PAID_TIER_MONTHLY_USD=5.00
MAX_EXTRACTED_CHARS=50000

# Durable jobs and shared rate limits
# Use redis://<host>:6379/0 in production; empty is acceptable only for local single-process use.
RATE_LIMIT_STORAGE_URI=
JOB_POLL_SECONDS=1
JOB_STALE_SECONDS=300
JOB_MAX_ATTEMPTS=3

# Local development upload fallback
UPLOAD_DIR=./uploads

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Admin and observability
ADMIN_EMAILS=
SENTRY_DSN_API=
AXIOM_TOKEN=
AXIOM_DATASET=reviewflow-prod
RESEND_API_KEY=

# Polar billing. Keep disabled until live checkout, webhook, and deletion tests pass.
BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# These are Polar product IDs, not legacy price IDs.
POLAR_PLUS_MONTHLY_PRODUCT_ID=
POLAR_PLUS_YEARLY_PRODUCT_ID=

# Cloudflare R2 uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reviewflow-uploads
R2_ENDPOINT_URL=
R2_PRESIGN_EXPIRY_SECONDS=300
