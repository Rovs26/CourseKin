# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=ReviewFlow API
# "development" | "production"
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev; set to a Neon postgres:// URL in production (Phase 4)
DATABASE_URL=sqlite:///./data/reviewflow.db

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# TODO (Phase 2): Get from Clerk dashboard → API Keys
CLERK_SECRET_KEY=
# TODO (Phase 2): Get from Clerk dashboard → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL=

# ── AI (OpenAI) ───────────────────────────────────────────────────────────────
# Required: your OpenAI API key
OPENAI_API_KEY=
# Model to use for generation; default is gpt-4o-mini (Phase 1 switches to gpt-4.1-nano)
OPENAI_MODEL=gpt-4o-mini

# ── Cost controls ─────────────────────────────────────────────────────────────
# TODO (Phase 1): Maximum USD spend allowed per user per calendar month
FREE_TIER_MONTHLY_USD=1.00
# TODO (Phase 1): Maximum characters of source text sent to OpenAI per generation
MAX_SOURCE_CHARS=50000

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
# TODO (Phase 5): Get from Cloudflare R2 dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reviewflow-uploads
R2_PUBLIC_URL=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins; include https://reviewflow.app in prod
FRONTEND_URL=http://localhost:3000

# ── Observability ─────────────────────────────────────────────────────────────
# TODO (Phase 8): Get from Sentry dashboard → Settings → Projects → DSN
SENTRY_DSN=
# TODO (Phase 8): Get from Axiom dashboard → Settings → API Tokens
AXIOM_TOKEN=
AXIOM_DATASET=reviewflow-logs

# ── Abuse prevention ─────────────────────────────────────────────────────────
# TODO (Phase 7): Get from Cloudflare dashboard → Turnstile
TURNSTILE_SECRET_KEY=
